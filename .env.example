# ============================================================================
# LUGAR — environment contract. Copy to `.env.local` and fill in.
# NEVER commit a filled-in copy. Variable NAMES only live in this file.
# ============================================================================

# --- Application ---------------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, sitemap, OG tags
# and the WhatsApp webhook callback URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ------------------------------------------------------------
# Local dev: matches docker-compose.yml.
# Railway: use the PRIVATE hostname (postgres.railway.internal) — the public
# TCP proxy host bills egress. Add `?sslmode=require` for public connections.
DATABASE_URL=postgresql://lugar:lugar@localhost:5432/lugar

# --- Auth (better-auth) --------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# One-time bootstrap of the first `owner` account. After an owner exists the
# bootstrap route refuses to run, regardless of this value.
INITIAL_OWNER_EMAIL=

# --- Object storage (Cloudflare R2, S3-compatible) -----------------------
# Leave R2_* empty in local dev to fall back to on-disk storage in .storage/
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=lugar-media
# Public base URL that serves objects from the bucket (R2 public dev URL or a
# custom domain). Must be reachable by next/image remotePatterns.
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Transactional email (Resend) ----------------------------------------
# Used for admin invitations and password resets only.
RESEND_API_KEY=
EMAIL_FROM="LUGAR <no-reply@example.com>"

# --- WhatsApp ------------------------------------------------------------
# mode: fallback | mock | cloud_api
#   fallback  — wa.me links only; no programmatic sending. Safe default.
#   mock      — records outbound messages in the DB, never hits the network.
#   cloud_api — live Meta Cloud API. Requires every WHATSAPP_* value below.
WHATSAPP_MODE=fallback

# Public click-to-chat number, digits only, E.164 without '+'.
NEXT_PUBLIC_WHATSAPP_PHONE=34624527303

WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (a personal user token expires in hours — do not use one).
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret. Signs the X-Hub-Signature-256 webhook header.
WHATSAPP_APP_SECRET=
# Arbitrary string you also paste into Meta's webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Comma-separated E.164 numbers that receive internal new-lead alerts.
# NOTE: staff numbers get no opt-in exemption — each must opt in, and
# out-of-window alerts require an approved UTILITY template.
WHATSAPP_INTERNAL_RECIPIENTS=
WHATSAPP_LEAD_ALERT_TEMPLATE_NAME=
WHATSAPP_LEAD_ALERT_TEMPLATE_LANGUAGE=ru

# --- Preview / cron ------------------------------------------------------
# Signs time-limited CMS preview links. openssl rand -base64 32
PREVIEW_SECRET=
# Bearer token guarding scheduled maintenance endpoints.
CRON_SECRET=

# --- Analytics (optional, consent-gated) ---------------------------------
# Tags stay inert until the visitor grants the matching consent category.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
