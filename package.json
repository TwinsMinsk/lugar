{
  "name": "lugar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "auth:bootstrap": "tsx --conditions=react-server scripts/bootstrap-owner.ts",
    "build": "next build",
    "build:standalone": "node scripts/prepare-standalone.mjs",
    "db:clean-test-projects": "tsx --conditions=react-server scripts/clean-test-projects.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server src/db/migrate.ts",
    "db:reset": "tsx --conditions=react-server scripts/reset-db.ts",
    "db:seed": "tsx --conditions=react-server src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preflight": "tsx --conditions=react-server scripts/preflight.ts",
    "postbuild": "npm run build:standalone",
    "prebuild": "tsx --conditions=react-server scripts/migrate-for-build.ts",
    "start": "node .next/standalone/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --conditions=react-server src/worker/outbox-worker.ts",
    "worker:dev": "tsx watch --conditions=react-server src/worker/outbox-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1109.0",
    "@aws-sdk/s3-request-presigner": "3.1109.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/core": "3.30.1",
    "@tiptap/html": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "better-auth": "1.6.27",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "gsap": "3.15.0",
    "libphonenumber-js": "1.13.10",
    "motion": "13.1.0",
    "next": "16.3.0",
    "next-intl": "4.13.6",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "rate-limiter-flexible": "11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "resend": "6.19.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tsx": "4.23.12",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "^17.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
